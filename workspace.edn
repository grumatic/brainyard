{:top-namespace "ai.brainyard",
 :interface-ns "interface",
 :default-profile-name "default",
 :compact-views #{},
 :vcs {:name "git", :auto-add false},
 :tag-patterns {:stable "stable-*", :release "v[0-9]*"},
 ;; :necessary — components reached only from a project's own src/ (which
 ;; Polylith does not scan as a brick), so warning 207 would otherwise call
 ;; them unused. `effect` is here because `main.clj` requires it directly for
 ;; the `effect-smoke` gate; nothing in a base uses it yet.
 :projects {"agent-tui-app" {:alias "ata", :necessary ["analytics" "web-share" "os-sandbox" "effect"]}
            "acp-stub-agent" {:alias "asa"}}}
